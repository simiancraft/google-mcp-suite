{
  "name": "google-mcp-suite",
  "version": "1.20.0",
  "type": "module",
  "description": "Google Workspace MCP servers for AI agents, one per service per account: Gmail, Google Calendar, Google Drive, Google Docs, and Google Sheets. Identity is bound to the running instance, so an agent (Claude, Cursor, or any MCP client) can never act on the wrong account; each server exposes Google's curated MCP toolset (where one exists) plus the broader REST surface.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "google-workspace",
    "google",
    "gmail",
    "google-calendar",
    "google-drive",
    "google-docs",
    "google-sheets",
    "email",
    "calendar",
    "scheduling",
    "sheets",
    "spreadsheet",
    "docs",
    "drive",
    "shared-drive",
    "oauth",
    "multi-account",
    "agent",
    "ai-agent",
    "claude",
    "cursor",
    "llm"
  ],
  "author": "the-simian <info@simiancraft.com>",
  "license": "MIT",
  "homepage": "https://github.com/simiancraft/google-mcp-suite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simiancraft/google-mcp-suite.git"
  },
  "bugs": {
    "url": "https://github.com/simiancraft/google-mcp-suite/issues"
  },
  "bin": {
    "google-mcp-suite": "./dist/suite/index.js",
    "google-mcp-gmail": "./dist/gmail/index.js",
    "google-mcp-calendar": "./dist/calendar/index.js",
    "google-mcp-sheets": "./dist/sheets/index.js",
    "google-mcp-docs": "./dist/docs/index.js",
    "google-mcp-drive": "./dist/drive/index.js",
    "google-mcp-doctor": "./dist/doctor/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ADOPTING.md",
    "PROVISIONING.md",
    "llms-install.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "capabilities": "for f in src/*/capabilities.ts; do bun run \"$f\" || exit 1; done",
    "doctor": "bun run src/doctor/index.ts",
    "tokens": "bun run src/doctor/index.ts status",
    "reauth": "bun run src/doctor/index.ts auth",
    "check:knip": "knip",
    "check": "bun run lint:fix && bun run build && bun run typecheck && bun test --coverage && bun run check:knip",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/docs": "^10.0.0",
    "@googleapis/drive": "^21.0.0",
    "@googleapis/gmail": "^18.0.0",
    "@googleapis/sheets": "^14.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "addressparser": "^1.0.1",
    "google-auth-library": "10.5.0",
    "mail-mime-builder": "^1.0.1",
    "open": "^11.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@types/addressparser": "^1.0.3",
    "@types/bun": "^1.3.13",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fast-check": "^4.9.0",
    "knip": "^6.26.0",
    "semantic-release": "^25.0.5",
    "typescript": "^7.0.2"
  }
}
